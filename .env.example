# GitShield Environment Variables

# LLM Providers for Auto-Remediation & PR review (Optional, choose at least one if using --fix or the web reviewer)
GEMINI_API_KEY=""
ANTHROPIC_API_KEY=""
OPENAI_API_KEY=""

# Web reviewer: which provider/model to use. Defaults to the first provider with a key
# (anthropic -> gemini -> openai); "none" runs the static scanner only.
# LLM_PROVIDER="anthropic"
# LLM_MODEL="claude-opus-5-5"
# GITSHIELD_REVIEW_LANGUAGE="Turkish"

# GitHub access. Falls back to `gh auth token` when empty.
# Classic PAT: `repo` scope. Fine-grained PAT: Pull requests (RW), Issues (RW), Contents (R), Metadata (R).
GITHUB_TOKEN=""

# Local SQLite database for reviews and draft issues
# GITSHIELD_DB=".gitshield/web.db"

# Auto-review: seconds between polls of repos with the "Otomatik inceleme" switch on (0 = off)
# GITSHIELD_AUTO_REVIEW_INTERVAL="300"

# Notifications for finished reviews (all optional)
# GITSHIELD_SLACK_WEBHOOK="https://hooks.slack.com/services/..."
# GITSHIELD_DISCORD_WEBHOOK="https://discord.com/api/webhooks/..."
# GITSHIELD_TELEGRAM_BOT_TOKEN=""
# GITSHIELD_TELEGRAM_CHAT_ID=""
# Base URL used in notification links
# GITSHIELD_PUBLIC_URL="http://127.0.0.1:8000"

# Extra host names the local server may answer to (comma-separated). Only needed when you reach the
# dashboard through another local name; 127.0.0.1, localhost and ::1 are always allowed.
# GITSHIELD_ALLOWED_HOSTS=""
